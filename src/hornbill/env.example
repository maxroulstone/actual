# Persistent, server-only SQLite database. The Hornbill Docker volume mounts at /data.
DB_PATH=/data/truelayer.db

# Public URL allowlisted in the TrueLayer Console. Never expose the client secret.
TRUELAYER_REDIRECT_URI=https://admin.budget.maxroulstone.com/api/truelayer/callback
ADMIN_TOKENS_URL=https://admin.budget.maxroulstone.com/budget/tokens

# These are TrueLayer's public bank-route identifiers, not access or refresh tokens
# and not secrets. Fill them from the TrueLayer Console/provider documentation.
TRUELAYER_MONZO_PROVIDER_ID=
TRUELAYER_BARCLAYS_PROVIDER_ID=
TRUELAYER_AMEX_PROVIDER_ID=
