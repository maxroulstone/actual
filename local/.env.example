# Optional. The local UI works without these values and shows every bank as
# unconnected. Populate them only to test TrueLayer or Actual imports.

# TrueLayer sandbox/test-app credentials and public provider IDs.
TRUE_LAYER_CLIENT_ID=
TRUE_LAYER_CLIENT_SECRET=
TRUELAYER_AUTH_BASE_URL=https://auth.truelayer-sandbox.com
TRUELAYER_API_BASE_URL=https://api.truelayer-sandbox.com
TRUELAYER_MONZO_PROVIDER_ID=
TRUELAYER_BARCLAYS_PROVIDER_ID=
TRUELAYER_AMEX_PROVIDER_ID=

# Needed only for a real OAuth callback. Use a public HTTPS tunnel URL here,
# register the callback in TrueLayer, and keep the /api/truelayer/callback path.
TRUELAYER_REDIRECT_URI=http://localhost:8080/api/truelayer/callback
ADMIN_TOKENS_URL=http://localhost:8080/budget/tokens

# Optional: use a separate Actual test budget for import testing.
BUDGET_ID=
FILE_PASSWORD=
